  "cards": [
    {
      "dot": "cyan",
      "title": "一条共享主链",
      "items": [
        "Web 与 Electron 只在传输层分叉，进入 sendMessage 后共享同一套编排与状态模型",
        "AgentRun 事件统一承载回答、思考、工具轨迹和 A2UI，再流回前端"
      ]
    },
