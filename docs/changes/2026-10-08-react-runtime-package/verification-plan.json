{
  "mode": "claims",
  "claims": [
    {
      "id": "AC-001",
      "statement": "框架包独立构建、导入和打包，运行时不依赖 Mint",
      "risk": "high",
      "requiredEvidence": ["process-smoke"],
      "invariants": [
        "no_mint_runtime_import",
        "package_importable",
        "declarations_present",
        "package_packable",
        "installed_tarball_importable"
      ],
      "probes": ["runtime-package-smoke", "runtime-package-pack"]
    },
    {
      "id": "AC-002",
      "statement": "ReAct 核心完成有序多轮工具调用并按 call ID 回填结果",
      "risk": "high",
      "requiredEvidence": ["integration"],
      "invariants": ["tool_call_order", "call_id_correlation", "final_answer_stops_loop"],
      "probes": ["runtime-unit"]
    },
    {
      "id": "AC-003",
      "statement": "步数上限、取消、未知工具和工具失败均有确定边界",
      "risk": "high",
      "requiredEvidence": ["integration"],
      "invariants": ["bounded_steps", "abort_stops_new_work", "tool_error_not_success"],
      "probes": ["runtime-unit"]
    },
    {
      "id": "AC-004",
      "statement": "Mint 兼容入口、审批续跑和 AgentRun 事件语义保持兼容",
      "risk": "critical",
      "requiredEvidence": ["integration"],
      "invariants": ["legacy_entry_compatible", "approval_path_preserved", "single_terminal_event"],
      "probes": ["mint-adapter-regression"]
    },
    {
      "id": "AC-005",
      "statement": "无真实 API Key 和 Mint server 的 Node 示例可以运行",
      "risk": "medium",
      "requiredEvidence": ["process-smoke"],
      "invariants": ["no_api_key_required", "no_mint_server_required"],
      "probes": ["runtime-package-smoke"]
    },
    {
      "id": "AC-006",
      "statement": "Tool Runtime 可以独立构建、打包并在隔离 Node 项目中导入",
      "risk": "high",
      "requiredEvidence": ["process-smoke"],
      "invariants": [
        "tool_runtime_no_mint_import",
        "tool_runtime_tarball_importable",
        "tool_runtime_no_runtime_dependencies"
      ],
      "probes": ["tool-runtime-package-build", "tool-runtime-package-smoke"]
    },
    {
      "id": "AC-007",
      "statement": "通用 runtime 对注册、校验、策略 gate、timeout、abort 和异常有结构化边界",
      "risk": "high",
      "requiredEvidence": ["integration"],
      "invariants": [
        "unknown_tool_rejected",
        "no_execute_without_allow",
        "timeout_aborts_tool",
        "abort_prevents_execute",
        "structured_tool_result"
      ],
      "probes": ["tool-runtime-unit"]
    },
    {
      "id": "AC-008",
      "statement": "Mint 工具调用经过 Tool Runtime 且保留服务端安全策略、幂等和审计",
      "risk": "critical",
      "requiredEvidence": ["integration"],
      "invariants": [
        "approval_path_preserved",
        "invocation_ledger_preserved",
        "retry_safety_preserved",
        "audit_sink_preserved",
        "single_tool_execution_gate"
      ],
      "probes": ["mint-tool-runtime-regression"]
    },
    {
      "id": "AC-009",
      "statement": "独立 Node 使用方可注册自定义工具并验证 deny/allow/execute 结果",
      "risk": "medium",
      "requiredEvidence": ["process-smoke"],
      "invariants": [
        "no_mint_server_required",
        "policy_deny_exec_count_zero",
        "policy_allow_exec_count_one"
      ],
      "probes": ["tool-runtime-package-smoke"]
    }
  ]
}
