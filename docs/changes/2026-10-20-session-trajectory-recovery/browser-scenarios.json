      "route": "/chat",
      "ignoreConsoleErrors": ["frame-ancestors"],
      "setup": {
        "routes": [
          {
            "pattern": "**/api/conversations/trace-conversation/ingestion-events",
            "method": "GET",
            "contentType": "text/event-stream",
            "body": ": connected\n\n"
          },
          {
            "pattern": "**/api/agents",
            "method": "GET",
            "body": {
              "agents": [
                {
                  "id": "general",
                  "name": "通用助手",
                  "label": "通用助手",
                  "available": true
                }
              ]
            }
          },
          {
            "pattern": "**/api/settings",
            "method": "GET",
            "body": {
              "showReactSteps": true,
              "routingMode": "manual",
              "onboardingCompleted": true
            }
          },
          {
            "pattern": "**/api/endpoints",
            "method": "GET",
            "body": {
              "endpoints": [
                {
                  "id": "trace-fixture-model",
                  "name": "验收模型",
                  "apiUrl": "https://fixture.invalid/v1",
                  "apiKeyMasked": "fixture",
                  "modelId": "fixture-model",
                  "apiType": "openai",
                  "isActive": true,
                  "verifiedAt": "2026-10-20T13:30:00.000Z",
                  "sortOrder": 0,
                  "createdAt": "2026-10-20T13:30:00.000Z",
                  "updatedAt": "2026-10-20T13:30:00.000Z"
                }
              ]
            }
          },
          {
            "pattern": "**/api/conversations",
            "method": "GET",
            "body": {
              "conversations": [
                {
                  "id": "trace-conversation",
                  "title": "轨迹恢复验收",
                  "type": "chat",
                  "routingMode": "manual",
                  "lockedAgent": null,
                  "createdAt": "2026-10-20T13:30:00.000Z",
                  "updatedAt": "2026-10-20T13:30:00.000Z"
                }
              ]
            }
          },
          {
            "pattern": "**/api/conversations/trace-conversation/messages",
            "method": "GET",
            "body": {
              "messages": [
                {
                  "id": "user-old",
                  "conversationId": "trace-conversation",
                  "role": "user",
                  "content": "请分段写入测试文件",
                  "createdAt": "2026-10-20T13:30:00.000Z"
                }
              ]
            }
          },
          {
            "pattern": "**/api/conversations/trace-conversation/trajectory/events*afterSeq=*",
            "method": "GET",
            "contentType": "text/event-stream",
            "body": ": ready 3\n\n"
          },
          {
            "pattern": "**/api/conversations/*/agent-runs/recoverable",
            "method": "GET",
            "body": {
              "runs": []
            }
          },
          {
            "pattern": "**/api/conversations/trace-conversation/messages",
            "method": "POST",
            "contentType": "text/event-stream",
            "body": "data: {\"type\":\"run_started\",\"runId\":\"run-new\",\"conversationId\":\"trace-conversation\",\"sequence\":1,\"state\":\"running\"}\n\ndata: {\"type\":\"answer\",\"runId\":\"run-new\",\"sequence\":2,\"content\":\"已进入新的核对运行\"}\n\ndata: {\"type\":\"run_completed\",\"runId\":\"run-new\",\"sequence\":3,\"state\":\"completed\",\"content\":\"已进入新的核对运行\",\"reasoning\":\"\"}\n\ndata: [DONE]\n\n"
          },
