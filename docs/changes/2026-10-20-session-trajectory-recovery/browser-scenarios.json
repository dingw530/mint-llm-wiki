                  "detailAvailable": true,
                  "synthetic": true,
                  "relatedIds": ["call-1"]
                }
              ],
              "runs": [
                {
                  "runId": "run-trace",
                  "status": "interrupted",
                  "originRunId": null,
                  "turnId": "turn-trace",
                  "startedAt": "2026-10-20T13:30:00.000Z",
                  "endedAt": "2026-10-20T13:30:02.000Z"
                }
              ]
            }
          },
          {
            "pattern": "**/api/conversations/trace-conversation/trajectory/events/dispatch-1",
            "method": "GET",
            "body": {
              "eventId": "dispatch-1",
              "availability": "available",
              "historyCompleteness": "complete",
              "payload": {
                "schemaVersion": 1,
                "conversationId": "trace-conversation",
                "eventId": "dispatch-1",
                "seq": 2,
                "runId": "run-trace",
                "turnId": "turn-trace",
                "createdAt": "2026-10-20T13:30:02.000Z",
                "type": "tool_dispatch_committed",
                "round": 1,
                "callId": "call-1",
                "toolName": "write_file",
                "argumentsJson": "{\"path\":\"fixture.txt\",\"content\":\"fixture detail text\"}",
                "retrySafety": "never"
              }
            }
          },
          {
            "pattern": "**/api/conversations/trace-conversation/trajectory/events/result-1",
            "method": "GET",
            "body": {
              "eventId": "result-1",
              "availability": "available",
