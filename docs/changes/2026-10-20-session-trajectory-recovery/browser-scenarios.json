      },
      "steps": [
        {
          "action": "click",
          "target": {
            "role": "tab",
            "name": "轨迹"
          }
        },
        {
          "action": "waitFor",
          "text": "完整轨迹"
        },
        {
          "action": "assertText",
          "text": "结果未知"
        },
        {
          "action": "assertNotText",
          "text": "fixture detail text"
        },
        {
          "action": "click",
          "target": {
            "testId": "trace-row-tool-event-1"
          }
        },
        {
          "action": "waitFor",
          "text": "fixture detail text"
        },
        {
          "action": "assertRequests"
        }
