{
  "name": "@mint/agent-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Portable React components for agent traces and runtime state",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=18",
    "@mint/session": "*"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^24.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "test:host": "npm run build && node scripts/host-smoke.mjs",
    "test": "npm run build && node scripts/host-smoke.mjs && node scripts/ui-integration-smoke.mjs"
  }
}
