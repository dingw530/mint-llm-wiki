        "mustContainAny": [["BM25"], ["向量", "ANN"], ["关键词", "语义"]],
        "mustUseTools": ["wiki_search"],
        "maxToolCalls": 3,
        "requiredSourceFiles": ["2026-07-22-rag"],
        "minCitations": 1
